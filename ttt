  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getDatabase, ref, set, onValue, update, onDisconnect, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyBuHMgngzdgt_BDC6h4YEQVymDVmEbLs60",
      authDomain: "industrialleap.firebaseapp.com",
      databaseURL: "https://industrialleap-default-rtdb.firebaseio.com",
      projectId: "industrialleap",
      storageBucket: "industrialleap.firebasestorage.app",
      messagingSenderId: "1078886721555",
      appId: "1:1078886721555:web:22c18409c58909f92c37e6"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getDatabase(app);

    // Audio sound generator using Web Audio API
    class SoundFx {
      constructor() {
        this.ctx = null;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) this.ctx = new AudioContext();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playPop(freq = 440) {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(freq * 1.5, this.ctx.currentTime + 0.08);
          
          gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.08);

          osc.connect(gain);
          gain.connect(this.ctx.destination);

          osc.start();
          osc.stop(this.ctx.currentTime + 0.08);
        } catch(e) {}
      }

      playWin() {
        try {
          this.init();
          if (!this.ctx) return;
          const notes = [523.25, 659.25, 783.99, 1046.50];
          notes.forEach((freq, i) => {
            setTimeout(() => this.playPop(freq), i * 100);
          });
        } catch(e) {}
      }
    }

    const sound = new SoundFx();

    // App state
    let myRole = null; // 'avirup' | 'pavini' | null
    let roomRef = ref(db, 'games/avirup_vs_pavini');
    let currentGameData = null;

    // Default Images
    const DEFAULT_PICS = {
      avirup: "avirup.png",
      pavini: "pavini.png"
    };

    function checkPlayerIdentityFromUrl() {
      const search = window.location.search.toLowerCase();
      const hash = window.location.hash.toLowerCase();
      
      const params = new URLSearchParams(window.location.search);
      const idVal = (params.get('id') || params.get('player') || '').toLowerCase();

      if (idVal.includes('avirup') || search.includes('avirup') || hash.includes('avirup')) {
        return 'avirup';
      }
      if (idVal.includes('pavini') || search.includes('pavini') || hash.includes('pavini')) {
        return 'pavini';
      }
      return null;
    }

    async function startSession() {
      try {
        await signInAnonymously(auth);
        
        // Detect player role from URL
        const urlRole = checkPlayerIdentityFromUrl();
        if (urlRole) {
          setRole(urlRole);
        } else {
          // Show selection modal
          document.getElementById('modal-role').classList.remove('hidden');
          document.getElementById('modal-role').classList.add('flex');
        }

        // Setup share modal link values
        const baseUrl = window.location.origin + window.location.pathname;
        document.getElementById('link-avirup').value = `${baseUrl}?id=avirup`;
        document.getElementById('link-pavini').value = `${baseUrl}?id=pavini`;

        // Subscribe to RTDB changes
        setupBoardListener();

      } catch (error) {
        console.error("Auth error:", error);
        showToast("Error connecting to database", "error");
      }
    }

    function setRole(role) {
      myRole = role;
      const modalRole = document.getElementById('modal-role');
      if (modalRole) {
        modalRole.classList.add('hidden');
        modalRole.classList.remove('flex');
      }

      const roleLabel = document.getElementById('current-role-label');
      const badgeAvirup = document.getElementById('badge-avirup-you');
      const badgePavini = document.getElementById('badge-pavini-you');

      if (role === 'avirup') {
        if (roleLabel) roleLabel.innerText = "Playing as Avirup 👦";
        badgeAvirup?.classList.remove('hidden');
        badgePavini?.classList.add('hidden');
        showToast("Signed in as Avirup 👦");
      } else if (role === 'pavini') {
        if (roleLabel) roleLabel.innerText = "Playing as Pavini 👧";
        badgePavini?.classList.remove('hidden');
        badgeAvirup?.classList.add('hidden');
        showToast("Signed in as Pavini 👧");
      }

      // Update presence in RTDB
      setupPresence();
    }

    function setupPresence() {
      if (!myRole) return;
      const myPresenceRef = ref(db, `games/avirup_vs_pavini/presence/${myRole}`);
      set(myPresenceRef, { online: true, lastSeen: serverTimestamp() });
      onDisconnect(myPresenceRef).set({ online: false, lastSeen: serverTimestamp() });
    }

    function setupBoardListener() {
      onValue(roomRef, (snapshot) => {
        const data = snapshot.val();
        
        if (!data) {
          // Initialize state if first time
          initNewGameInDb();
          return;
        }

        currentGameData = data;
        renderApp(data);
      });

      // Reaction Emojis listener
      const reactionsRef = ref(db, 'games/avirup_vs_pavini/reactions');
      onValue(reactionsRef, (snapshot) => {
        const reaction = snapshot.val();
        if (reaction && reaction.timestamp > (Date.now() - 3000)) {
          triggerFloatingEmoji(reaction.emoji);
        }
      });
    }

    function initNewGameInDb() {
      const initialData = {
        board: Array(9).fill(""),
        turn: "avirup", // Avirup starts by default
        status: "playing", // 'playing', 'won', 'draw'
        winner: null,
        winningLine: null,
        scores: {
          avirup: 0,
          pavini: 0
        },
        pictures: {
          avirup: DEFAULT_PICS.avirup,
          pavini: DEFAULT_PICS.pavini
        }
      };
      set(roomRef, initialData);
    }

    function renderApp(data) {
      const { board, turn, status, winner, winningLine, scores, pictures, presence } = data;

      // Update Avatars
      const avirupPic = pictures?.avirup || DEFAULT_PICS.avirup;
      const paviniPic = pictures?.pavini || DEFAULT_PICS.pavini;

      document.getElementById('img-avirup-avatar').src = avirupPic;
      document.getElementById('img-pavini-avatar').src = paviniPic;

      // Update Scores
      document.getElementById('score-avirup').innerText = scores?.avirup || 0;
      document.getElementById('score-pavini').innerText = scores?.pavini || 0;

      // Update Online Presences
      updatePresenceUI(presence);

      // Card Active Turn Glows
      const cardAvirup = document.getElementById('card-avirup');
      const cardPavini = document.getElementById('card-pavini');

      cardAvirup.classList.remove('turn-glow-avirup');
      cardPavini.classList.remove('turn-glow-pavini');

      if (status === 'playing') {
        if (turn === 'avirup') {
          cardAvirup.classList.add('turn-glow-avirup');
        } else {
          cardPavini.classList.add('turn-glow-pavini');
        }
      }

      // Status Banner Text
      const statusText = document.getElementById('status-text');
      const statusSpinner = document.getElementById('status-spinner');

      if (status === 'playing') {
        statusSpinner.classList.remove('hidden');
        const isMyTurn = turn === myRole;
        const turnName = turn === 'avirup' ? 'Avirup' : 'Pavini';
        
        if (isMyTurn) {
          statusText.innerText = `YOUR TURN! Tap an empty spot to move.`;
          statusText.className = "text-emerald-300 font-bold animate-pulse-fast";
        } else {
          statusText.innerText = `Waiting for ${turnName}'s turn...`;
          statusText.className = "text-slate-300 font-semibold";
        }
      } else if (status === 'won') {
        statusSpinner.classList.add('hidden');
        const winnerName = winner === 'avirup' ? 'Avirup 👦' : 'Pavini 👧';
        statusText.innerText = `🎉 ${winnerName} WON THE GAME!`;
        statusText.className = winner === 'avirup' ? "text-indigo-300 font-extrabold text-base" : "text-pink-300 font-extrabold text-base";
      } else if (status === 'draw') {
        statusSpinner.classList.add('hidden');
        statusText.innerText = "🤝 IT'S A DRAW / TIE!";
        statusText.className = "text-amber-300 font-bold text-base";
      }

      // Render Grid Cells
      const cellElements = document.querySelectorAll('.game-cell');
      cellElements.forEach((cell, idx) => {
        const val = board[idx];
        cell.className = "game-cell glass-card cell-shadow rounded-2xl flex items-center justify-center p-2 hover:bg-slate-800/80 active:scale-95 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/50";
        
        // Render picture token if set
        if (val === 'avirup') {
          cell.innerHTML = `
            <img src="${avirupPic}" alt="Avirup" class="w-full h-full rounded-xl object-cover border-2 border-indigo-400 shadow-lg animate-pop">
          `;
        } else if (val === 'pavini') {
          cell.innerHTML = `
            <img src="${paviniPic}" alt="Pavini" class="w-full h-full rounded-xl object-cover border-2 border-pink-400 shadow-lg animate-pop">
          `;
        } else {
          cell.innerHTML = '';
        }

        // Highlight Winning Line
        if (winningLine && winningLine.includes(idx)) {
          if (winner === 'avirup') {
            cell.classList.add('win-glow-avirup', 'scale-105');
          } else if (winner === 'pavini') {
            cell.classList.add('win-glow-pavini', 'scale-105');
          }
        }
      });
    }

    function updatePresenceUI(presence) {
      const avirupOnline = presence?.avirup?.online;
      const paviniOnline = presence?.pavini?.online;

      const badgeA = document.getElementById('badge-avirup-status');
      const textA = document.getElementById('avirup-presence-text');
      if (avirupOnline) {
        badgeA.className = "absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-slate-900";
        textA.innerText = "Online";
        textA.className = "text-emerald-400 font-semibold";
      } else {
        badgeA.className = "absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-slate-500 border-2 border-slate-900";
        textA.innerText = "Offline";
        textA.className = "text-slate-400";
      }

      const badgeP = document.getElementById('badge-pavini-status');
      const textP = document.getElementById('pavini-presence-text');
      if (paviniOnline) {
        badgeP.className = "absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-slate-900";
        textP.innerText = "Online";
        textP.className = "text-emerald-400 font-semibold";
      } else {
        badgeP.className = "absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-slate-500 border-2 border-slate-900";
        textP.innerText = "Offline";
        textP.className = "text-slate-400";
      }
    }

    const WINNING_COMBINATIONS = [
      [0, 1, 2], [3, 4, 5], [6, 7, 8], // Rows
      [0, 3, 6], [1, 4, 7], [2, 5, 8], // Columns
      [0, 4, 8], [2, 4, 6]             // Diagonals
    ];

    function handleCellClick(index) {
      if (!myRole) {
        showToast("Please choose your player identity first!", "info");
        document.getElementById('modal-role').classList.remove('hidden');
        document.getElementById('modal-role').classList.add('flex');
        return;
      }

      if (!currentGameData) return;

      const { board, turn, status } = currentGameData;

      if (status !== 'playing') {
        showToast("Game is over. Click 'Play Again' to start!", "info");
        return;
      }

      if (turn !== myRole) {
        showToast(`It's ${turn === 'avirup' ? 'Avirup' : 'Pavini'}'s turn right now!`, "info");
        return;
      }

      if (board[index] !== "") {
        showToast("That spot is already taken!", "info");
        return;
      }

      // Sound Effect
      sound.playPop(myRole === 'avirup' ? 500 : 700);

      // Execute Move
      const newBoard = [...board];
      newBoard[index] = myRole;

      // Check Win or Draw
      let newStatus = 'playing';
      let winner = null;
      let winningLine = null;

      for (let combo of WINNING_COMBINATIONS) {
        const [a, b, c] = combo;
        if (newBoard[a] && newBoard[a] === newBoard[b] && newBoard[a] === newBoard[c]) {
          newStatus = 'won';
          winner = myRole;
          winningLine = combo;
          break;
        }
      }

      if (newStatus !== 'won' && !newBoard.includes("")) {
        newStatus = 'draw';
      }

      // Update Next Turn
      const nextTurn = myRole === 'avirup' ? 'pavini' : 'avirup';

      // Update Scores
      const newScores = { ...currentGameData.scores };
      if (newStatus === 'won') {
        newScores[winner] = (newScores[winner] || 0) + 1;
        sound.playWin();
        triggerConfetti();
      }

      // Push updates to Firebase RTDB
      update(roomRef, {
        board: newBoard,
        turn: nextTurn,
        status: newStatus,
        winner: winner,
        winningLine: winningLine,
        scores: newScores
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Cell clicks
      document.querySelectorAll('.game-cell').forEach(cell => {
        cell.addEventListener('click', () => {
          const idx = parseInt(cell.getAttribute('data-index'), 10);
          handleCellClick(idx);
        });
      });

      // Role Selection Buttons
      document.getElementById('select-avirup-btn')?.addEventListener('click', () => setRole('avirup'));
      document.getElementById('select-pavini-btn')?.addEventListener('click', () => setRole('pavini'));

      // Reset Board / Play Again Button
      document.getElementById('btn-reset')?.addEventListener('click', () => {
        if (!currentGameData) return;
        sound.playPop(600);
        update(roomRef, {
          board: Array(9).fill(""),
          turn: "avirup",
          status: "playing",
          winner: null,
          winningLine: null
        });
        showToast("New round started!");
      });

      // Reset Scores
      document.getElementById('btn-reset-scores')?.addEventListener('click', () => {
        sound.playPop(400);
        update(roomRef, {
          scores: { avirup: 0, pavini: 0 }
        });
        showToast("Scores reset to 0!");
      });

      // Share Modal Toggle
      document.getElementById('btn-share')?.addEventListener('click', () => {
        const modalShare = document.getElementById('modal-share');
        if (modalShare) {
          modalShare.classList.remove('hidden');
          modalShare.classList.add('flex');
        }
      });
      document.getElementById('close-share-modal')?.addEventListener('click', () => {
        const modalShare = document.getElementById('modal-share');
        if (modalShare) {
          modalShare.classList.add('hidden');
          modalShare.classList.remove('flex');
        }
      });

      // Emoji Reaction Buttons
      document.querySelectorAll('.emoji-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const emoji = btn.dataset.emoji;
          sound.playPop(800);
          const reactionsRef = ref(db, 'games/avirup_vs_pavini/reactions');
          set(reactionsRef, {
            emoji: emoji,
            sender: myRole || 'anonymous',
            timestamp: Date.now()
          });
        });
      });

      // Global Clipboard Function helper
      window.copyToClipboard = function(inputId, btnId) {
        const input = document.getElementById(inputId);
        input.select();
        document.execCommand('copy');
        
        const btn = document.getElementById(btnId);
        const originalText = btn.innerText;
        btn.innerText = "Copied! ✓";
        btn.classList.remove('bg-indigo-600', 'bg-pink-600');
        btn.classList.add('bg-emerald-600');

        setTimeout(() => {
          btn.innerText = originalText;
          btn.classList.remove('bg-emerald-600');
          btn.classList.add(inputId.includes('avirup') ? 'bg-indigo-600' : 'bg-pink-600');
        }, 2000);

        showToast("Link copied to clipboard!");
      };

      // Start Realtime Session
      startSession();
    });

    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');
      const toastIcon = document.getElementById('toast-icon');

      toastMsg.innerText = msg;
      if (type === 'error') {
        toastIcon.className = "fa-solid fa-circle-exclamation text-rose-400";
      } else if (type === 'info') {
        toastIcon.className = "fa-solid fa-circle-info text-sky-400";
      } else {
        toastIcon.className = "fa-solid fa-circle-check text-emerald-400";
      }

      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }

    function triggerFloatingEmoji(emoji) {
      const container = document.getElementById('emoji-container');
      const el = document.createElement('div');
      el.innerText = emoji;
      el.className = "absolute text-4xl transform -translate-x-1/2 transition-all duration-1000 ease-out";
      
      const randomLeft = Math.random() * 80 + 10; // 10% to 90%
      el.style.left = `${randomLeft}%`;
      el.style.bottom = '10%';
      el.style.opacity = '1';

      container.appendChild(el);

      requestAnimationFrame(() => {
        el.style.transform = 'translate(-50%, -300px) scale(1.5)';
        el.style.opacity = '0';
      });

      setTimeout(() => el.remove(), 1200);
    }

    function triggerConfetti() {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 80,
          spread: 70,
          origin: { y: 0.6 }
        });
      }
    }
  </script>
</body>
</html>
